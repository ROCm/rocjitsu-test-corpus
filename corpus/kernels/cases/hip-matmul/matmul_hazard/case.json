{
  "name": "hip_matmul_matmul_hazard",
  "project": "hip-matmul",
  "runner": "runner.hip",
  "kind": "cmake_executable",
  "targets": [
    "gfx942"
  ],
  "build": {
    "system": "cmake",
    "target": "hip_matmul_matmul_hazard"
  },
  "executable": "cases/hip-matmul/hip_matmul_matmul_hazard",
  "tests": {
    "m4096_n4096_k4096": {
      "test_args": [
        "-m",
        4096,
        "-n",
        4096,
        "-k",
        4096
      ],
      "env": {
        "BENCHMARK_MIN_MS": "1",
        "FIXED_ITERATIONS": "1"
      },
      "validation": {
        "kind": "exit_code",
        "pass_exit_code": -6
      }
    }
  },
  "tags": [
    "hip-matmul",
    "matmul",
    "hazard",
    "regression"
  ]
}
