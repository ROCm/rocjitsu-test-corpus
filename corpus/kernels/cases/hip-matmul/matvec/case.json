{
  "name": "hip_matmul_matvec",
  "project": "hip-matmul",
  "runner": "runner.hip",
  "kind": "cmake_executable",
  "supported_targets": [
    "gfx942",
    "gfx1201"
  ],
  "build": {
    "system": "cmake",
    "target": "hip_matmul_matvec"
  },
  "executable": "cases/hip-matmul/hip_matmul_matvec",
  "tests": {
    "m256_n1_k1024": {
      "test_args": [
        "-m",
        256,
        "-n",
        1,
        "-k",
        1024
      ],
      "env": {
        "BENCHMARK_MIN_MS": "1",
        "FIXED_ITERATIONS": "1"
      },
      "validation": {
        "kind": "exit_code",
        "pass_exit_code": 0
      }
    }
  },
  "tags": [
    "hip-matmul",
    "matvec",
    "regression"
  ]
}
