# Support groups describe packet layouts, not individual GPU products.
# Evidence and capability boundaries: ../pm4/REFERENCES.md.
function(torture_platform arch)
  if(NOT arch MATCHES "^gfx(9|11|12)([0-9a-f])([0-9a-f])$")
    message(FATAL_ERROR "Unsupported target: ${arch}; supported families are gfx9, gfx11, gfx12.0 and gfx12.5")
  endif()
  set(major ${CMAKE_MATCH_1})
  math(EXPR minor "0x${CMAKE_MATCH_2}")
  math(EXPR stepping "0x${CMAKE_MATCH_3}")
  math(EXPR version "${major} * 10000 + ${minor} * 100 + ${stepping}")
  set(features pm4 pm4_wait64 pm4_release_mem aql_pm4_ib)
  set(wave_option -mno-wavefrontsize64)
  if(major EQUAL 9 AND version LESS_EQUAL 90500)
    set(profile gfx9)
    set(wave_option -mwavefrontsize64)
  elseif(major EQUAL 11 OR (major EQUAL 12 AND minor EQUAL 0 AND stepping LESS_EQUAL 1))
    set(profile gfx11)
  elseif(version EQUAL 120500)
    set(profile gfx125)
    list(APPEND features aql_metadata sdma_signal64 pm4_wait_offload)
  else()
    message(FATAL_ERROR "No documented support profile for ${arch}")
  endif()
  if(major EQUAL 12)
    list(APPEND features wave32_scratch wgp_placement)
  endif()
  set(platform_features ${features} PARENT_SCOPE)
  set(pm4_profile ${profile} PARENT_SCOPE)
  set(gfx_version ${version} PARENT_SCOPE)
  set(kernel_wave_option ${wave_option} PARENT_SCOPE)
  message(STATUS "${arch}: PM4 support=${profile}; features=${features}")
endfunction()
