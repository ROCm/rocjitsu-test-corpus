{
  "name": "llama_rms_norm",
  "project": "llama.cpp",
  "runner": "runner.cpp",
  "kind": "cmake_executable",
  "architectures": [
    "cdna3",
    "rdna4"
  ],
  "build": {
    "system": "cmake",
    "target": "llama_cpp_rms_norm"
  },
  "run": {
    "executable": "cases/llama.cpp/llama_cpp_rms_norm",
    "args": [
      "--n-embd",
      128,
      "--n-tokens",
      1,
      "--validate"
    ],
    "gpu_timeout_seconds": 15,
    "cpu_timeout_seconds": 15
  },
  "validation": {
    "kind": "exit_code",
    "pass_exit_code": 0,
    "abs_tolerance": 0.00001
  },
  "tags": [
    "llama.cpp",
    "ggml",
    "rms-norm",
    "regression"
  ]
}
