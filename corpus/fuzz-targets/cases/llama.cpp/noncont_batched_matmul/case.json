{
  "name": "llama_noncont_batched_matmul",
  "project": "llama.cpp",
  "runner": "runner.cpp",
  "kind": "cmake_executable",
  "architectures": [
    "cdna3",
    "rdna4"
  ],
  "build": {
    "system": "cmake",
    "target": "llama_cpp_noncont_batched_matmul"
  },
  "executable": "cases/llama.cpp/llama_cpp_noncont_batched_matmul",
  "tests": {
    "default": {
      "test_args": [
        "--k-dim",
        64,
        "--output-rows",
        32,
        "--src1-view-cols",
        17,
        "--src1-parent-cols",
        17,
        "--src1-batches",
        2,
        "--src1-layout=contiguous",
        "--validate"
      ],
      "validation": {
        "kind": "exit_code",
        "pass_exit_code": 0,
        "abs_tolerance": 0.001
      }
    }
  },
  "tags": [
    "llama.cpp",
    "ggml",
    "matmul",
    "non-contiguous",
    "regression"
  ]
}
