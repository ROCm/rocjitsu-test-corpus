{
  "name": "llama_mul_mat_vec_q",
  "project": "llama.cpp",
  "runner": "runner.cpp",
  "kind": "cmake_executable",
  "architectures": [
    "cdna3",
    "rdna4"
  ],
  "build": {
    "system": "cmake",
    "target": "llama_cpp_mul_mat_vec_q"
  },
  "run": {
    "executable": "cases/llama.cpp/llama_cpp_mul_mat_vec_q",
    "args": [
      "--n-embd",
      128,
      "--n-tokens",
      1,
      "--validate"
    ],
    "timeout_seconds": 120
  },
  "validation": {
    "kind": "exit_code",
    "pass_exit_code": 0,
    "abs_tolerance": 0.01
  },
  "tags": [
    "llama.cpp",
    "ggml",
    "matvec",
    "quantized",
    "regression"
  ]
}
