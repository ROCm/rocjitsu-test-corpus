{
  "name": "llama_noncont_batched_matmul_hazard",
  "project": "llama.cpp",
  "runner": "runner.cpp",
  "kind": "cmake_executable",
  "architectures": [
    "cdna3",
    "rdna4"
  ],
  "build": {
    "system": "cmake",
    "target": "llama_cpp_noncont_batched_matmul_hazard"
  },
  "run": {
    "executable": "cases/llama.cpp/llama_cpp_noncont_batched_matmul_hazard-build/rocfuzz_llama_noncont_batched_matmul_hazard_runner",
    "args": [
      "--k-dim",
      64,
      "--output-rows",
      32,
      "--src1-view-cols",
      17,
      "--src1-parent-cols",
      32,
      "--src1-batches",
      2,
      "--src1-layout=noncontiguous",
      "--validate"
    ],
    "gpu_timeout_seconds": 15,
    "cpu_timeout_seconds": 15
  },
  "validation": {
    "kind": "exit_code",
    "pass_exit_code": 1,
    "abs_tolerance": 0.001
  },
  "tags": [
    "llama.cpp",
    "ggml",
    "matmul",
    "non-contiguous",
    "hazard",
    "pr13155",
    "regression"
  ]
}
