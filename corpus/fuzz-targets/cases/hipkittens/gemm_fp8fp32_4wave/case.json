{
  "name": "hipkittens_gemm_fp8fp32_4wave",
  "project": "hipkittens",
  "runner": "runner.hip",
  "kind": "cmake_executable",
  "architectures": [
    "cdna4"
  ],
  "build": {
    "system": "cmake",
    "target": "hipkittens_gemm_fp8fp32_4wave"
  },
  "run": {
    "executable": "cases/hipkittens/hipkittens_gemm_fp8fp32_4wave",
    "args": [
      "-m",
      256,
      "-n",
      256,
      "-k",
      256,
      "--rotating-buffer-count",
      4
    ],
    "gpu_timeout_seconds": 15,
    "cpu_timeout_seconds": 15
  },
  "validation": {
    "kind": "exit_code",
    "pass_exit_code": 0
  },
  "tags": [
    "hipkittens",
    "gemm",
    "fp8-fp32",
    "cdna4",
    "regression"
  ]
}
