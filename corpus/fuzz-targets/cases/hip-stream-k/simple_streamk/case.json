{
  "name": "hip_streamk_simple",
  "project": "hip-stream-k",
  "runner": "runner.cpp",
  "kind": "cmake_executable",
  "architectures": [
    "cdna3"
  ],
  "build": {
    "system": "cmake",
    "target": "hip_streamk_simple"
  },
  "run": {
    "executable": "cases/hip-stream-k/hip_streamk_simple",
    "args": [
      "-m",
      256,
      "-n",
      256,
      "-k",
      256,
      "--grid",
      4,
      "--num_runs",
      1,
      "--validate"
    ],
    "gpu_timeout_seconds": 15,
    "cpu_timeout_seconds": 15
  },
  "validation": {
    "kind": "exit_code",
    "pass_exit_code": 0
  },
  "tags": [
    "hip-stream-k",
    "gemm",
    "simple-streamk",
    "regression"
  ]
}
