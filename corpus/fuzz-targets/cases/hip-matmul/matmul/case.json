{
  "name": "hip_matmul_matmul",
  "project": "hip-matmul",
  "runner": "runner.hip",
  "kind": "cmake_executable",
  "architectures": [
    "cdna3"
  ],
  "build": {
    "system": "cmake",
    "target": "hip_matmul_matmul"
  },
  "run": {
    "executable": "cases/hip-matmul/hip_matmul_matmul",
    "args": [
      "-m",
      256,
      "-n",
      256,
      "-k",
      256
    ],
    "env": {
      "BENCHMARK_MIN_MS": "1",
      "FIXED_ITERATIONS": "1"
    },
    "gpu_timeout_seconds": 15,
    "cpu_timeout_seconds": 15
  },
  "validation": {
    "kind": "exit_code",
    "pass_exit_code": 0
  },
  "tags": [
    "hip-matmul",
    "matmul",
    "regression"
  ]
}
