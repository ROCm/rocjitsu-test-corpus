{
  "name": "hip_matmul_matvec",
  "project": "hip-matmul",
  "runner": "runner.hip",
  "kind": "cmake_executable",
  "architectures": [
    "cdna3",
    "rdna4"
  ],
  "build": {
    "system": "cmake",
    "target": "hip_matmul_matvec"
  },
  "run": {
    "executable": "cases/hip-matmul/hip_matmul_matvec",
    "args": [
      "-m",
      4096,
      "-n",
      1,
      "-k",
      4096
    ],
    "env": {
      "BENCHMARK_MIN_MS": "1",
      "FIXED_ITERATIONS": "1"
    },
    "gpu_timeout_seconds": 15,
    "cpu_timeout_seconds": 15
  },
  "validation": {
    "kind": "exit_code",
    "pass_exit_code": 0
  },
  "tags": [
    "hip-matmul",
    "matvec",
    "regression"
  ]
}
