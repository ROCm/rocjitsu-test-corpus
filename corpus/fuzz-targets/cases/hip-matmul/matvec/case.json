{
  "name": "hip_matmul_matvec",
  "project": "hip-matmul",
  "runner": "runner.hip",
  "kind": "cmake_executable",
  "default_variant": "upstream",
  "architectures": ["cdna3", "rdna4"],
  "build": {
    "system": "cmake",
    "target": "hip_matmul_matvec"
  },
  "run": {
    "executable": "cases/hip-matmul/hip_matmul_matvec",
    "args": [],
    "env": {
      "BENCHMARK_MIN_MS": "1",
      "FIXED_ITERATIONS": "1"
    },
    "timeout_seconds": 120
  },
  "validation": {
    "kind": "exit_code",
    "pass_exit_code": 0
  },
  "tags": ["hip-matmul", "matvec", "regression"]
}
